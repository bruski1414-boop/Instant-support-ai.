DATABASE_URL=
DATABASE_SSL=true
DB_POOL_SIZE=5
BOOTSTRAP_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=3000
ALLOWED_ORIGINS=https://your-hotel-domain.example
NODE_ENV=production
STAFF_WEBHOOK_URL=
STAFF_WEBHOOK_SECRET=

# Enable only after the hotel's privacy notice, retention and data terms are approved.
GUEST_DATA_STORAGE_ENABLED=false

# Separate AES-256-GCM key for encrypted booking guest details (base64-encoded 32-byte key).
BOOKING_DATA_ENCRYPTION_KEY=
# Set true only after a daily cleanup job is deployed and monitored.
BOOKING_PII_CLEANUP_ENABLED=false
