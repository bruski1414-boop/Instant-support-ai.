# Copy this file to .env on the server. Never commit your real .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=3000
# Private PostgreSQL connection; set DATABASE_SSL=true when the provider requires verified TLS.
DATABASE_URL=
DATABASE_SSL=false
# Exact public origin, e.g. https://your-domain.example (required in production for login/logout origin checks).
APP_ORIGIN=
BUSINESS_NAME=Sample Business
BUSINESS_FAQ=
# Optional: private Slack-compatible incoming webhook for staff handoff alerts.
# Configure only with the business owner's permission. Guest message content is excluded by default.
HANDOFF_WEBHOOK_URL=
# Set true only after an explicit privacy review and business-owner approval.
HANDOFF_INCLUDE_MESSAGE=false